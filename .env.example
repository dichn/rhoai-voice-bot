# Copy to .env (gitignored) and fill in real values.
# Never commit real API keys to this repo.

# DeepSeek API key, used by Open WebUI as the chat-completion provider.
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-REPLACE_ME

# Optional: Open WebUI session-signing secret. If unset, `make secret`
# generates a random one automatically.
# WEBUI_SECRET_KEY=
