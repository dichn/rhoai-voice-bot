# envsubst template -- same pattern as
# third_party/openshift-ai-bootstrap/yaml/infra/dashboard-dspa-secret.yaml.tmpl
#
# Usage:
#   DEEPSEEK_API_KEY=sk-... WEBUI_SECRET_KEY=$(openssl rand -hex 32) \
#     envsubst < openshift/deepseek-secret.yaml.tmpl | oc apply -n rhoai-voice-bot -f -
kind: Secret
apiVersion: v1
metadata:
  name: voice-bot-secrets
  namespace: rhoai-voice-bot
stringData:
  DEEPSEEK_API_KEY: ${DEEPSEEK_API_KEY}
  WEBUI_SECRET_KEY: ${WEBUI_SECRET_KEY}
type: Opaque
